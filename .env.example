# Rhino Compute server. Local Rhino.Compute commonly listens on 6500.
RHINO_COMPUTE_URL=http://localhost:6500

# Optional depending on your deployment.
RHINO_COMPUTE_KEY=
RHINO_COMPUTE_TOKEN=

# Optional trusted service that executes Rhino/Grasshopper Python generator scripts.
# POST contract: { "script": "...", "name": "..." }
# Response: { "files": [{ "name": "catalog.zip", "mime": "application/zip", "base64": "..." }], "warnings": [], "log": "..." }
GRASSHOPPER_GENERATOR_URL=
GRASSHOPPER_GENERATOR_TOKEN=
